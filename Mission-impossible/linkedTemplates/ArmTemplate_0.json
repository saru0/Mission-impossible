{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Mission-impossible"
		},
		"AzureDataLakeStorage2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage2'"
		},
		"AzureDataLakeStorage2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalakesarany.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeStorage2')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AzureDataLakeStorage2_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('AzureDataLakeStorage2_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Excel1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage2",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Excel",
				"typeProperties": {
					"sheetName": "Sheet1",
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "companies_task_ss.xlsx",
						"fileSystem": "infoo"
					},
					"firstRowAsHeader": true
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Lets_send _mails')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "get_emailIDs",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "ExcelSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							},
							"dataset": {
								"referenceName": "Excel1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Filtering_nulls",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('get_emailIDs').output.value\n",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Web_send_mails",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "POST",
										"headers": {},
										"url": "https://prod-03.centralindia.logic.azure.com:443/workflows/f0277993b53248fca68279d19dd44230/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=82TDF0OvdKtusRr0OAPxCq5-u9s2ykNChYl3HxLJiAo",
										"body": {
											"value": "{\n  \"hr_name\": \"@{item().Name}\",\n  \"email\": \"@{item().Email}\",\n  \"subject\": \"Exploring Data Engineer Opportunities\",\n  \"message\": \"Hi,\n\nI hope you're doing well.\n\nI'm reaching out to explore Data Engineering opportunities at your organization.\n\nI have hands-on experience with Python, SQL, PySpark, Azure Data Factory, and Azure Databricks, working on ETL/ELT pipelines, data ingestion, batch and incremental processing, and data transformations.\n\nMy project experience also includes Delta Lake, lakehouse architecture, data modelling, data quality checks, pipeline monitoring, error handling, metadata-driven orchestration, and Git-based version control.\n\nI recently developed a cloud-integrated ETL project demonstrating these practical data engineering workflows:\n\nGitHub: https://github.com/saru0/Mission-impossible\n\nI'd appreciate your consideration for any suitable Data Engineer openings where I can contribute and grow.\n\nThank you for your time.\n\nBest regards,\nSaranya\nPhone: +91-7396528898 \"\n}",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Filtering_nulls",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "get_emailIDs",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('get_emailIDs').output.value",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(\n    not(empty(item().Email)),\n    not(equals(trim(item().Email), ''))\n)",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Excel1')]"
			]
		}
	]
}